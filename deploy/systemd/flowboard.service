# /etc/systemd/system/flowboard.service
[Unit]
Description=Vulpfin Flowboard (uvicorn)
After=network.target

[Service]
User=flowboard
Group=flowboard
WorkingDirectory=/var/www/Flowboard
EnvironmentFile=/var/www/Flowboard/.env
Environment="PYTHONUNBUFFERED=1"
ExecStart=/var/www/Flowboard/.venv/bin/uvicorn app.main:app --host 127.0.1.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/Flowboard/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
