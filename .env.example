# Vulpfin Flowboard 2.x configuration.  Copy to `.env` and fill in.
# Never commit the real file.  Generate the two keys with:  python -m app.cli gen-keys

# --- core ------------------------------------------------------------------
FLOWBOARD_ENV=production                    # production | development | test
FLOWBOARD_SECRET_KEY=change-me              # signs session cookies / OAuth state (>= 32 random chars)
FLOWBOARD_CREDENTIAL_ENCRYPTION_KEY=change-me   # base64/hex 32-byte AES-256-GCM key for stored API keys & OAuth tokens
# Rotation: add FLOWBOARD_CREDENTIAL_ENCRYPTION_KEY_V2=... then run `python -m app.cli rotate-credential-keys`
FLOWBOARD_SITE_URL=https://flowboard.fyi    # canonical absolute URL (emails, OAuth callbacks, feed URLs)
FLOWBOARD_SITE_NAME=Vulpfin Flowboard
FLOWBOARD_ALLOWED_HOSTS=flowboard.fyi,flowboard.vulpfin.com,127.0.1.1,localhost
FLOWBOARD_TRUSTED_ORIGINS=https://flowboard.fyi,https://flowboard.vulpfin.com   # CSRF Origin check
FLOWBOARD_DATABASE_URL=                     # empty => sqlite in FLOWBOARD_DATA_DIR; or postgresql+psycopg://user:pw@host/db
FLOWBOARD_DATA_DIR=/var/www/Flowboard/data  # sqlite file + runtime data
FLOWBOARD_ALLOW_REGISTRATION=true           # set false to make the instance invite-only (create users with the CLI)
FLOWBOARD_COOKIE_SECURE=true
FLOWBOARD_SESSION_MAX_AGE=1209600           # seconds (14 days)
FLOWBOARD_AI_LOG_PROMPTS=false              # store prompt/response text in ai_usage (metadata is always stored)
FLOWBOARD_PROXY_HEADERS=true                # trust X-Forwarded-* from Apache
FLOWBOARD_LEGACY_TASKS_JSON=/var/www/Flowboard/flowboard_tasks.json   # informational; used by `import-legacy`

# --- email (password reset) -------------------------------------------------
SMTP_HOST=mail.tg11.org
SMTP_PORT=587
SMTP_USER=noreply@tg11.org
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Vulpfin Flowboard <noreply@tg11.org>
# Where the footer's "Contact support" form sends (defaults to the EMAIL_FROM address).
# Keep comments on their own lines: systemd's EnvironmentFile does not strip inline ones.
FLOWBOARD_SUPPORT_EMAIL=
FLOWBOARD_SUPPORT_MAX_PER_HOUR=5

# --- Google Calendar (OAuth 2.0 web application) ---------------------------
# Console: https://console.cloud.google.com/apis/credentials  -> enable "Google Calendar API"
# Authorised redirect URI: https://flowboard.fyi/calendar/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft 365 / Outlook (Entra ID app registration) --------------------
# Portal: https://entra.microsoft.com -> App registrations -> Web platform
# Redirect URI: https://flowboard.fyi/calendar/connect/microsoft/callback
# API permissions (delegated): Calendars.ReadWrite, User.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common                  # or your tenant id for single-tenant

# --- TG11 identity (OpenID Connect) ------------------------------------------
# Leave empty until accounts.tg11.org exists; local login keeps working.
TG11_OIDC_ISSUER=                           # e.g. https://accounts.tg11.org
TG11_OIDC_CLIENT_ID=
TG11_OIDC_CLIENT_SECRET=
TG11_OIDC_SCOPES=openid profile email
TG11_OIDC_LOGIN_LABEL=Sign in with TG11
TG11_LOCAL_LOGIN_ENABLED=true               # set false once everyone has linked a TG11 identity
